# Public site origin, used for canonicals, sitemaps and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=https://www.1minhotspot.com

# Facebook Page numeric id — Meta Business Suite → Page → About → Page ID.
FB_PAGE_ID=
# Page access token with pages_read_engagement — Graph API Explorer, then
# exchange it for a long-lived token. Server-side only, never NEXT_PUBLIC_.
FB_ACCESS_TOKEN=
# Graph API version used for the /videos read path. Optional — the code
# falls back to v26.0 if unset (see lib/providers/facebook.ts).
FB_API_VERSION=v26.0

# YouTube Data API v3 key — Google Cloud console → APIs & Services → Credentials
# → Create credentials → API key. NOTE: client_secrets.json in this repo is an
# OAuth *desktop* client and cannot authorise server-side public reads; a plain
# API key is required instead. Do not attempt OAuth.
YT_API_KEY=
# Channel id (starts with UC...) — YouTube Studio → Settings → Channel → Advanced.
YT_CHANNEL_ID=

# Neon Postgres connection string — Vercel → Storage → Neon integration injects
# this automatically. Unset is a supported state: the site falls back to the
# live Facebook feed and every lib/store.ts call returns empty.
DATABASE_URL=
# Shared secret n8n sends as the `x-ingest-secret` header on POST /api/ingest.
# Unset means the endpoint rejects everything — it fails closed, by design.
INGEST_SECRET=
# Cloudflare R2 bucket for thumbnails. Cloudflare → R2 → bucket → Settings →
# Custom Domains gives R2_PUBLIC_HOST; R2 → Manage API tokens → Object Read &
# Write (scoped to the bucket) gives the key pair; the account id is on the R2
# overview page. All five unset means thumbnails stay on the Facebook CDN and
# expire in ~6 days.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=1minhotspot-thumbs
R2_PUBLIC_HOST=thumbs.1minhotspot.com=
